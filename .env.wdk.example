# WDK local config (do not commit secrets)

# Use a dedicated hackathon/test wallet only — never a personal funded wallet.
WDK_WALLET_NAME=casandra-dev
# Prefer Sepolia / testnets for demos (see https://docs.wdk.tether.io)
WDK_DEFAULT_NETWORK=sepolia

# Optional MoonPay / indexer keys if using buy_crypto or get_history via wdk-mcp
# MOONPAY_API_KEY=
# WDK_INDEXER_URL=
